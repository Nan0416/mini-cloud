# Both are optional, and both are *defaults* rather than the source of truth: a
# `?backend=` link and then this browser's stored choice each win over them.
#
# Leave them unset and the console asks where the service is on first load, which is
# what a bundle served from anywhere but the service's own machine needs. Set them and
# the prompt never appears — the behaviour a bundle built for one known service wants.

# Base URL of the mini-cloud service.
# VITE_MINI_CLOUD_API_URL=http://127.0.0.1:3001

# The service's MINI_CLOUD_PUBLIC_TOKEN, sent as a bearer token on every request. The
# public listener always requires one, so the console always sends one. Baked into the
# bundle at build time, so treat a build made with this set as being as secret as the
# token itself. Leaving it unset does not lock you out: the setup screen asks for the
# token on first load and the browser stores it.
# VITE_MINI_CLOUD_TOKEN=
