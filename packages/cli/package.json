{
  "name": "@mini-cloud/cli",
  "version": "1.0.0",
  "private": true,
  "description": "The mini-cloud command line: start the service, run an agent, manage tasks.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mini-cloud": "./bin/mini-cloud.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf dist build tsconfig.tsbuildinfo",
    "build:sea:linux": "bash scripts/build-linux-sea.sh",
    "build:sea:mac": "bash scripts/build-mac-sea-unsigned.sh",
    "build:sea:mac:signed": "bash scripts/build-mac-sea-signed.sh"
  },
  "dependencies": {
    "@mini-cloud/agent": "1.0.0",
    "@mini-cloud/client": "1.0.0",
    "@mini-cloud/service": "1.0.0",
    "@mini-cloud/shared": "1.0.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "postject": "^1.0.0-alpha.6",
    "tsup": "^8.5.1"
  },
  "license": "MIT"
}
