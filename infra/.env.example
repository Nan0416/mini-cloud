# Copy to infra/.env and fill in. That file is gitignored: an account id and a hosted
# zone id identify one person's AWS estate, so neither belongs in the source.
#
# Nothing here has a default. A deploy script that guesses is a stack in the wrong
# account, which is worse than a script that refuses to start.

# The AWS account to deploy into. Twelve digits.
MINI_CLOUD_AWS_ACCOUNT=

# An existing Route 53 hosted zone, imported rather than created by this stack.
# `aws route53 list-hosted-zones` prints ids as /hostedzone/Z…; use the Z… part only.
MINI_CLOUD_HOSTED_ZONE_ID=

# That zone's apex.
MINI_CLOUD_ZONE_NAME=qinnan.dev

# Where the console is served. Must sit inside the zone above.
MINI_CLOUD_CONSOLE_DOMAIN=mini-cloud.qinnan.dev
