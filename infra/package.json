{
  "name": "mini-cloud-infra",
  "version": "1.0.0",
  "private": true,
  "description": "CDK app for the hosted console: one stack holding the bucket, the distribution, the certificate and the DNS records.",
  "scripts": {
    "typecheck": "tsc",
    "synth": "AWS_PROFILE=mini-cloud cdk synth",
    "diff": "AWS_PROFILE=mini-cloud cdk diff",
    "deploy": "AWS_PROFILE=mini-cloud cdk deploy",
    "destroy": "AWS_PROFILE=mini-cloud cdk destroy",
    "format": "prettier --write \"{bin,lib}/**/*.ts\"",
    "format:lint": "prettier --check \"{bin,lib}/**/*.ts\"",
    "cdk": "AWS_PROFILE=mini-cloud cdk"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.266.0",
    "constructs": "^10.5.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "aws-cdk": "2.1139.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3"
  },
  "license": "MIT"
}
